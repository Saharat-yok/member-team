PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/task-manager
# สร้าง secret ด้วย: openssl rand -hex 32
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Web Push (สร้างคีย์ด้วย: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ใช้ป้องกัน endpoint ที่ Vercel Cron เรียก (สร้างด้วย: openssl rand -hex 32)
CRON_SECRET=
